    <script>
        const utils = {
            uuid: () => typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).substring(2),
            escapeHTML: (str) => String(str).replace(/[&<>'"]/g, tag => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'}[tag])),
            escapeRegex: (str) => String(str).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'),
            formatDate: (ts) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(ts)),
            formatShort: (ts) => {
                const d = new Date(ts);
                return (new Date().toDateString() === d.toDateString()) ? 
                    `Today, ${d.toLocaleTimeString('en-US', {hour: '2-digit', minute:'2-digit'})}` : 
                    d.toLocaleDateString('en-US', {month: 'short', day: 'numeric'});
            },
            getSize: (str) => new TextEncoder().encode(str).length,
            
            // --- Kalkulator Logic ---
            formatNumber: (num) => {
                if (Number.isInteger(num)) return num.toLocaleString('id-ID');
                return num.toLocaleString('id-ID', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
            },
            
            evaluateMath: (expression) => {
                try {
                    let cleanExpr = expression.replace(/\s+/g, '')
                                              .replace(/[xX]/g, '*')
                                              .replace(/\./g, ''); 
                                              
                    cleanExpr = cleanExpr.replace(/k/gi, '000').replace(/rb/gi, '000')
                                         .replace(/jt/gi, '000000').replace(/m/gi, '000000');

                    if (!/^[0-9+\-*/().]+$/.test(cleanExpr)) return null;

                    const result = new Function(`return ${cleanExpr}`)();
                    
                    if (typeof result === 'number' && isFinite(result)) {
                         return result;
                    }
                    return null;
                } catch (e) {
                    return null;
                }
            },
            
            parseCalculatorText: (text) => {
                if (!text) return '';
                
                const lines = text.split('\n');
                const processedLines = lines.map(line => {
                    let textPart = line;
                    let mathPart = '';
                    let hasEquals = false;

                    if (line.includes('=')) {
                        const parts = line.split('=');
                        mathPart = parts.pop().trim();
                        textPart = parts.join('=') + ' = ';
                        hasEquals = true;
                    } else {
                        return `<span class="editor-text-content">${utils.escapeHTML(line)}</span>`;
                    }

                    if (hasEquals && mathPart) {
                        const result = utils.evaluateMath(mathPart);
                        if (result !== null) {
                            return `<span class="editor-text-content">${utils.escapeHTML(line)}</span><span class="calc-result-wrapper"><span class="calc-result">${utils.formatNumber(result)}</span></span>`;
                        }
                    }
                    
                    return `<span class="editor-text-content">${utils.escapeHTML(line)}</span>`;
                });

                return processedLines.join('\n');
            }
        };

        const setupViewport = () => {
            if (window.visualViewport) {
                const adjustHeight = () => { document.body.style.height = `${window.visualViewport.height}px`; };
                window.visualViewport.addEventListener('resize', adjustHeight);
                window.visualViewport.addEventListener('scroll', adjustHeight);
                adjustHeight(); 
            }
        };

        let deferredPrompt;
        const setupPWA = () => {
            const manifest = {
                name: "My Notes", short_name: "MyNotes", display: "standalone", start_url: ".",
                background_color: "#0F0F0F", theme_color: "#0F0F0F", description: "Minimalist Offline Note-taking App with Calculator",
                icons: [ { src: "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjM0I4MkY2IiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBvbHlnb24gcG9pbnRzPSIxNCAyIDE4IDYgNyAxNyAzIDE3IDMgMTMgMTQgMiI+PC9wb2x5Z29uPjwvc3ZnPg==", sizes: "192x192 512x512", type: "image/svg+xml" } ]
            };
            document.getElementById('pwa-manifest').href = 'data:application/manifest+json;charset=utf-8,' + encodeURIComponent(JSON.stringify(manifest));

            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault(); deferredPrompt = e;
                document.getElementById('btnInstallApp').style.display = 'block';
                document.getElementById('installMsg').style.display = 'none';
            });

            document.getElementById('btnInstallApp').addEventListener('click', async () => {
                if (deferredPrompt) {
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    if (outcome === 'accepted') { deferredPrompt = null; document.getElementById('btnInstallApp').style.display = 'none'; }
                }
            });

            const updateOnlineStatus = () => {
                const badge = document.getElementById('offlineBadge');
                if (navigator.onLine) badge.classList.remove('show');
                else badge.classList.add('show');
            };
            window.addEventListener('online', updateOnlineStatus);
            window.addEventListener('offline', updateOnlineStatus);
            updateOnlineStatus();
        };

        const app = {
            data: { version: 1, createdAt: Date.now(), notes: [], trash: [], settings: { sort: 'updatedDesc' } },
            state: { activeId: null, view: 'list', search: '', filter: 'all', menuTarget: null, undoStack: [], history: [], historyIdx: -1 },
            cache: { saveTimer: null, searchTimer: null, toastTimer: null, maxStorage: 5 * 1024 * 1024 },
            els: {},

            init() {
                this.cacheDOM();
                this.loadData();
                this.bindEvents();
                this.handleRouting();
                this.updateStorageUI();
                setupViewport();
                setupPWA();
            },

            cacheDOM() {
                const el = (id) => document.getElementById(id);
                this.els = {
                    body: document.body, list: el('notesList'), search: el('searchInput'),
                    viewEditor: el('editorView'), viewSettings: el('settingsView'), emptyState: el('emptyState'),
                    title: el('editorTitle'), bodyInput: el('editorBody'), renderLayer: el('editorRenderLayer'),
                    tags: el('editorTags'), tagInput: el('tagInput'),
                    lastEdited: el('lastEdited').querySelector('span'), btnPin: el('btnPin'), trashBanner: el('trashBanner'),
                    importFile: el('importFile'), storageProg: el('storageProgress'), storageLbl: el('storageLabel'),
                    trashBadge: el('trashBadge'), globalMenu: el('globalMenu'), sortMenu: el('sortMenu'),
                    toast: el('toast'), toastMsg: el('toastMsg'), toastUndo: el('toastUndo'),
                    emptyTitle: el('emptyTitle'), emptyDesc: el('emptyDesc'),
                    menuChecklist: el('menuChecklist'), menuUndo: el('menuUndo'),
                    menuPin: el('menuPin'), menuRename: el('menuRename'), menuDownload: el('menuDownload'), menuCopy: el('menuCopy'), divBot: el('divBot')
                };
            },

            loadData() {
                try {
                    const local = localStorage.getItem('mynotes_final');
                    if (local) {
                        const p = JSON.parse(local);
                        if (p && Array.isArray(p.notes)) {
                            this.data.notes = p.notes;
                            this.data.trash = Array.isArray(p.trash) ? p.trash : [];
                            this.data.settings = p.settings || { sort: 'updatedDesc' };
                        }
                    }
                } catch (e) {}
            },

            saveData() {
                try {
                    const dataStr = JSON.stringify(this.data);
                    localStorage.setItem('mynotes_final', dataStr);
                    this.updateStorageUI();
                    this.updateTrashBadge();
                    return true;
                } catch(e) {
                    this.toast('Storage Full! Changes reverted.');
                    this.loadData(); this.renderList();
                    if (this.state.activeId) this.renderEditor();
                    return false;
                }
            },

            recordSnapshot(title, content) {
                if (this.state.historyIdx >= 0) {
                    const curr = this.state.history[this.state.historyIdx];
                    if (curr.title === title && curr.content === content) return;
                }
                if (this.state.historyIdx < this.state.history.length - 1) {
                    this.state.history = this.state.history.slice(0, this.state.historyIdx + 1);
                }
                
                this.state.history.push({ title, content });
                this.state.historyIdx++;
                
                if (this.state.history.length > 50) {
                    this.state.history.shift();
                    this.state.historyIdx--;
                }
            },

            performSaveAndSnapshot() {
                const currentId = this.state.activeId;
                const note = this.getNote(currentId);
                if (note) {
                    note.title = this.els.title.value;
                    note.content = this.els.bodyInput.value;
                    note.updatedAt = Date.now();
                    
                    this.recordSnapshot(note.title, note.content);
                    this.saveData();
                    this.updateNoteCardInList(note);
                    this.els.lastEdited.textContent = `Last edited: ${utils.formatDate(note.updatedAt)}`;
                }
            },

            flushSave() {
                if (this.cache.saveTimer) {
                    clearTimeout(this.cache.saveTimer);
                    this.performSaveAndSnapshot();
                }
            },

            getNote(id) { return this.data.notes.find(n => n.id === id) || this.data.trash.find(n => n.id === id); },

            createNote() {
                const note = { id: utils.uuid(), title: '', content: '', tags: [], pinned: false, createdAt: Date.now(), updatedAt: Date.now() };
                this.data.notes.unshift(note);
                this.state.search = ''; this.els.search.value = '';
                this.setFilter('all');
                if (this.saveData()) {
                    this.setActive(note.id);
                    setTimeout(() => { this.els.title.focus(); }, 50);
                }
            },

            deleteNoteSoft(id) {
                const idx = this.data.notes.findIndex(n => n.id === id);
                if (idx > -1) {
                    const note = this.data.notes.splice(idx, 1)[0];
                    note.deletedAt = Date.now();
                    this.data.trash.unshift(note);
                    if (this.saveData()) {
                        this.state.undoStack.push({ action: 'trash', note: { ...note } });
                        if (this.state.undoStack.length > 20) this.state.undoStack.shift();
                        this.toast('Moved to Trash', true);
                        this.handleRemoval(id);
                    }
                }
            },

            restoreNote(id) {
                const idx = this.data.trash.findIndex(n => n.id === id);
                if (idx > -1) {
                    const note = this.data.trash.splice(idx, 1)[0];
                    delete note.deletedAt;
                    note.updatedAt = Date.now();
                    this.data.notes.unshift(note);
                    if (this.saveData()) {
                        this.toast('Note Restored');
                        if (this.state.filter === 'trash') this.handleRemoval(id);
                        else { this.renderList(); this.setActive(id); }
                    }
                }
            },

            undoTrash() {
                const last = this.state.undoStack.pop();
                if (last && last.action === 'trash') { this.restoreNote(last.note.id); }
                this.els.toast.classList.remove('show');
            },

            deleteNoteHard(id) {
                this.data.trash = this.data.trash.filter(n => n.id !== id);
                if (this.saveData()) { this.toast('Deleted Forever'); this.handleRemoval(id); }
            },

            emptyTrash() {
                if (this.data.trash.length === 0) return;
                this.data.trash = [];
                if (this.saveData()) {
                    this.toast('Trash emptied');
                    if (this.state.filter === 'trash') { this.state.activeId = null; this.handleRouting(); }
                    else this.updateTrashBadge();
                }
            },

            handleRemoval(id) {
                if (this.state.activeId === id) { this.state.activeId = null; this.handleRouting(); } 
                else this.renderList();
            },

            toggleProperty(id, prop, msgOn, msgOff) {
                const note = this.getNote(id);
                if (!note || note.deletedAt) return;
                note[prop] = !note[prop];
                note.updatedAt = Date.now();
                if (this.saveData()) {
                    this.handleRouting();
                    if (this.state.activeId === id) this.renderEditor();
                    this.toast(note[prop] ? msgOn : msgOff);
                }
            },

            addTag(id, tagStr) {
                const tag = tagStr.trim().toLowerCase();
                if (!tag) return;
                const note = this.getNote(id);
                if (note && !note.deletedAt) {
                    if (!note.tags) note.tags = [];
                    if (!note.tags.includes(tag)) {
                        note.tags.push(tag);
                        note.updatedAt = Date.now();
                        if (this.saveData()) { this.renderEditorTags(note); this.updateNoteCardInList(note); }
                    }
                }
            },

            removeTag(id, tag) {
                const note = this.getNote(id);
                if (note && note.tags) {
                    note.tags = note.tags.filter(t => t !== tag);
                    note.updatedAt = Date.now();
                    if (this.saveData()) { this.renderEditorTags(note); this.updateNoteCardInList(note); }
                }
            },

            handleRouting() {
                const isDesk = window.innerWidth >= 768;
                const filtered = this.getFiltered();
                
                if (this.state.activeId && !filtered.some(n => n.id === this.state.activeId)) this.state.activeId = null;

                this.renderList();
                this.updateTrashBadge();

                if (filtered.length === 0) {
                    this.setView(isDesk ? 'editor' : 'list'); this.showEmptyState();
                } else {
                    if (isDesk && !this.state.activeId) this.setActive(filtered[0].id);
                    else if (!isDesk && !this.state.activeId) this.setView('list');
                    else if (this.state.activeId) this.setActive(this.state.activeId);
                }
            },

            setActive(id) {
                this.flushSave(); 
                this.state.activeId = id;
                
                this.state.history = [];
                this.state.historyIdx = -1;
                
                this.setView('editor');
                
                document.querySelectorAll('.note-card').forEach(el => el.classList.remove('active'));
                const card = document.querySelector(`.note-card[data-id="${id}"]`);
                if (card && window.innerWidth >= 768) card.classList.add('active');
                
                this.renderEditor();

                const note = this.getNote(id);
                if(note && !note.deletedAt) {
                    this.recordSnapshot(note.title || '', note.content || '');
                }
            },

            setView(viewName) {
                this.state.view = viewName;
                this.els.body.setAttribute('data-view', viewName);
                this.els.viewEditor.classList.remove('active');
                this.els.viewSettings.classList.remove('active');
                this.els.emptyState.classList.remove('active');

                if (viewName === 'editor') {
                    if (this.state.activeId) this.els.viewEditor.classList.add('active');
                    else this.showEmptyState();
                } else if (viewName === 'settings') {
                    this.els.viewSettings.classList.add('active');
                }
            },

            showEmptyState() {
                this.els.emptyState.classList.add('active');
                this.els.viewEditor.classList.remove('active');
                
                let title = "No notes found", desc = "Create your first note to get started";
                const btn = document.querySelector('.empty-state .btn-new');
                
                if (this.state.filter === 'trash') { title = "Trash is empty"; desc = "Deleted notes will appear here."; btn.style.display = 'none'; }
                else if (this.state.filter === 'pinned') { title = "No pinned notes"; desc = "Pin a note to keep it on top."; btn.style.display = 'block'; }
                else if (this.state.filter === 'tagged') { title = "No tagged notes"; desc = "Add tags to your notes to organize them."; btn.style.display = 'block'; }
                else { btn.style.display = 'block'; }
                
                this.els.emptyTitle.textContent = title;
                this.els.emptyDesc.textContent = desc;
                
                this.els.title.value = '';
                this.els.bodyInput.value = '';
                this.updateRenderLayer();
            },

            setFilter(filter) {
                this.state.filter = filter;
                document.querySelectorAll('.filter-chip').forEach(el => el.classList.toggle('active', el.dataset.filter === filter));
                this.state.activeId = null;
                this.handleRouting();
            },

            getFiltered() {
                let source = this.state.filter === 'trash' ? this.data.trash : this.data.notes;
                let filtered = source.filter(n => {
                    if (this.state.filter === 'pinned') return n.pinned;
                    if (this.state.filter === 'tagged') return n.tags && n.tags.length > 0;
                    return true;
                });

                const q = this.state.search;
                if (q) {
                    filtered = filtered.filter(n => 
                        (n.title||'').toLowerCase().includes(q) || 
                        (n.content||'').toLowerCase().includes(q) ||
                        (n.tags||[]).some(t => t.toLowerCase().includes(q))
                    );
                }

                const sort = this.data.settings.sort;
                filtered.sort((a, b) => {
                    if (this.state.filter !== 'trash') {
                        if (a.pinned && !b.pinned) return -1;
                        if (!a.pinned && b.pinned) return 1;
                    }
                    if (sort === 'updatedDesc') return b.updatedAt - a.updatedAt;
                    if (sort === 'createdDesc') return b.createdAt - a.createdAt;
                    if (sort === 'createdAsc') return a.createdAt - b.createdAt;
                    if (sort === 'titleAsc') return (a.title||'').localeCompare(b.title||'');
                    if (sort === 'titleDesc') return (b.title||'').localeCompare(a.title||'');
                    return 0;
                });
                return filtered;
            },

            getHighlightHTML(text) {
                if(!this.state.search || !text) return utils.escapeHTML(text || '');
                const escText = utils.escapeHTML(text);
                const escSearch = utils.escapeRegex(utils.escapeHTML(this.state.search));
                const regex = new RegExp(`(${escSearch})`, 'gi');
                return escText.replace(regex, '<span class="highlight">$1</span>');
            },

            renderList() {
                const notes = this.getFiltered();
                if (notes.length === 0) {
                    this.els.list.innerHTML = ``;
                    if(window.innerWidth >= 768 && this.state.view === 'editor') this.showEmptyState();
                    return;
                }

                const isDesk = window.innerWidth >= 768;
                const isTrash = this.state.filter === 'trash';
                let html = '', hasPinned = false, hasOthers = false;

                notes.forEach(n => {
                    if (this.state.filter === 'all' || this.state.filter === 'tagged') {
                        if (n.pinned && !hasPinned) { html += `<div class="section-title">📌 Pinned</div>`; hasPinned = true; }
                        else if (!n.pinned && !hasOthers) { html += `<div class="section-title">All Notes</div>`; hasOthers = true; }
                    }

                    const activeClass = (n.id === this.state.activeId && isDesk) ? 'active' : '';
                    
                    html += `
                    <div class="note-card ${activeClass}" data-id="${n.id}">
                        <div class="card-header">
                            <div class="card-title">${this.getHighlightHTML(n.title) || 'Untitled Note'}</div>
                            <div style="font-size: 0.8rem;">${n.pinned && !isTrash ? '📌' : ''}</div>
                        </div>
                        <div class="card-preview">${this.getHighlightHTML(n.content) || 'No additional text'}</div>
                        <div class="card-footer">
                            <div class="tags-row">${(n.tags||[]).map(t => `<span class="tag-chip">${this.getHighlightHTML(t)}</span>`).join('')}</div>
                            <div class="card-date">${utils.formatShort(n.updatedAt)}</div>
                        </div>
                        <button class="btn-dots-small" data-action="cardMenu">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
                        </button>
                    </div>`;
                });
                this.els.list.innerHTML = html;
            },

            updateNoteCardInList(note) {
                const card = document.querySelector(`.note-card[data-id="${note.id}"]`);
                if(card) {
                    const titleEl = card.querySelector('.card-title');
                    const previewEl = card.querySelector('.card-preview');
                    const dateEl = card.querySelector('.card-date');
                    const tagsEl = card.querySelector('.tags-row');
                    
                    if(titleEl) titleEl.innerHTML = this.getHighlightHTML(note.title) || 'Untitled Note';
                    if(previewEl) previewEl.innerHTML = this.getHighlightHTML(note.content) || 'No additional text';
                    if(dateEl) dateEl.textContent = utils.formatShort(note.updatedAt);
                    if(tagsEl) tagsEl.innerHTML = (note.tags||[]).map(t => `<span class="tag-chip">${this.getHighlightHTML(t)}</span>`).join('');
                }
            },

            renderEditor() {
                const note = this.getNote(this.state.activeId);
                if (!note) return;

                const isTrash = !!note.deletedAt;
                this.els.title.value = note.title || '';
                this.els.bodyInput.value = note.content || '';
                this.els.lastEdited.textContent = `Last edited: ${utils.formatDate(note.updatedAt)}`;
                
                this.els.btnPin.classList.toggle('active', note.pinned);

                if (isTrash) {
                    this.els.viewEditor.classList.add('is-trash');
                    this.els.trashBanner.style.display = 'flex';
                    this.els.title.readOnly = true;
                    this.els.bodyInput.readOnly = true;
                    this.els.btnPin.style.display = 'none';
                } else {
                    this.els.viewEditor.classList.remove('is-trash');
                    this.els.trashBanner.style.display = 'none';
                    this.els.title.readOnly = false;
                    this.els.bodyInput.readOnly = false;
                    this.els.btnPin.style.display = 'flex';
                }

                this.renderEditorTags(note);
                this.updateRenderLayer(); 
            },
            
            updateRenderLayer() {
                const text = this.els.bodyInput.value;
                this.els.renderLayer.innerHTML = utils.parseCalculatorText(text) + '<br><br>'; 
            },

            renderEditorTags(note) {
                const oldTags = this.els.tags.querySelectorAll('.tag-edit');
                oldTags.forEach(t => t.remove());
                
                if (note && note.tags) {
                    note.tags.forEach(tag => {
                        const t = document.createElement('div');
                        t.className = 'tag-edit';
                        t.dataset.tag = tag;
                        t.innerHTML = `${utils.escapeHTML(tag)} <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:4px; opacity:0.7;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;
                        this.els.tags.insertBefore(t, this.els.tagInput);
                    });
                }
            },

            toggleChecklist() {
                this.flushSave();

                const textarea = this.els.bodyInput;
                const start = textarea.selectionStart;
                const end = textarea.selectionEnd;
                const val = textarea.value;

                let lineStart = val.lastIndexOf('\n', start - 1) + 1;
                let lineEnd = val.indexOf('\n', end);
                if (lineEnd === -1) lineEnd = val.length;

                let line = val.substring(lineStart, lineEnd);
                let diff = 0;

                if (line.startsWith('☐ ')) {
                    line = '☑ ' + line.substring(2);
                } else if (line.startsWith('☑ ')) {
                    line = line.substring(2);
                    diff = -2;
                } else {
                    line = '☐ ' + line;
                    diff = 2;
                }

                textarea.value = val.substring(0, lineStart) + line + val.substring(lineEnd);
                textarea.selectionStart = textarea.selectionEnd = Math.max(0, start + diff);
                
                this.updateRenderLayer();
                this.performSaveAndSnapshot();
                textarea.focus();
            },

            copyNoteText(id) {
                const note = this.getNote(id);
                if (!note) return;
                const textToCopy = (note.title ? note.title + '\n\n' : '') + (note.content || '');
                
                const el = document.createElement('textarea');
                el.value = textToCopy;
                document.body.appendChild(el);
                el.select();
                try {
                    document.execCommand('copy');
                    this.toast('Note disalin ke clipboard!');
                } catch (err) {
                    this.toast('Gagal menyalin note');
                }
                document.body.removeChild(el);
            },

            bindEvents() {
                document.body.addEventListener('click', (e) => {
                    const btn = e.target.closest('[data-action]');
                    if (btn) {
                        const action = btn.dataset.action;
                        switch(action) {
                            case 'settings': this.setView('settings'); break;
                            case 'backToList': this.flushSave(); this.setView('list'); break;
                            case 'newNote': this.createNote(); break;
                            case 'sortMenu': this.openMenu(e, null, 'sortMenu'); break;
                            case 'editorMenu': this.openMenu(e, this.state.activeId, 'globalMenu'); break;
                            case 'cardMenu': this.openMenu(e, btn.closest('.note-card').dataset.id, 'globalMenu'); break;
                            case 'togglePin': this.toggleProperty(this.state.activeId, 'pinned', 'Note Pinned', 'Note Unpinned'); break;
                            case 'restore': this.restoreNote(this.state.activeId); break;
                            case 'deleteForever': if(confirm("Delete forever? This cannot be undone.")) this.deleteNoteHard(this.state.activeId); break;
                            case 'export': this.exportBackup(); break;
                            case 'triggerImport': this.els.importFile.click(); break;
                            case 'emptyTrash': if(confirm("Empty all trash?")) this.emptyTrash(); break;
                            case 'undoTrash': this.undoTrash(); break;
                            case 'wipeAll': 
                                if(confirm("WIPE ALL DATA? This deletes everything permanently.")) {
                                    this.data = { version: 1, createdAt: Date.now(), notes: [], trash: [], settings: { sort: 'updatedDesc' } };
                                    this.saveData(); this.state.activeId = null; this.toast('All data wiped'); this.handleRouting();
                                }
                                break;
                        }
                    }

                    const card = e.target.closest('.note-card');
                    if (card && !e.target.closest('.btn-dots-small')) { this.setActive(card.dataset.id); }

                    const filterChip = e.target.closest('.filter-chip');
                    if (filterChip) { this.setFilter(filterChip.dataset.filter); }

                    const tagEl = e.target.closest('.tag-edit');
                    if(tagEl && this.state.filter !== 'trash') { this.removeTag(this.state.activeId, tagEl.dataset.tag); }

                    if (!e.target.closest('.dropdown') && !e.target.closest('[data-action$="Menu"]')) { this.closeMenus(); }
                });

                const handleInput = () => {
                    if(this.state.filter === 'trash') return;
                    
                    this.updateRenderLayer();
                    this.els.renderLayer.scrollTop = this.els.bodyInput.scrollTop;
                    
                    clearTimeout(this.cache.saveTimer);
                    this.cache.saveTimer = setTimeout(() => {
                        this.performSaveAndSnapshot();
                    }, 500);
                };
                
                this.els.title.addEventListener('input', handleInput);
                this.els.bodyInput.addEventListener('input', handleInput);
                
                this.els.bodyInput.addEventListener('scroll', () => {
                    this.els.renderLayer.scrollTop = this.els.bodyInput.scrollTop;
                });

                const saveTag = () => {
                    const val = this.els.tagInput.value.trim().replace(/,/g, '');
                    if (val) { this.addTag(this.state.activeId, val); this.els.tagInput.value = ''; }
                };
                this.els.tagInput.addEventListener('keyup', (e) => {
                    if (e.key === 'Enter' || e.key === ',' || e.keyCode === 13) { e.preventDefault(); saveTag(); }
                });
                this.els.tagInput.addEventListener('blur', () => saveTag());

                this.els.search.addEventListener('input', (e) => {
                    clearTimeout(this.cache.searchTimer);
                    this.cache.searchTimer = setTimeout(() => {
                        this.state.search = e.target.value.toLowerCase();
                        this.handleRouting();
                    }, 200);
                });

                this.els.globalMenu.addEventListener('click', (e) => {
                    const item = e.target.closest('.menu-item');
                    if(!item || item.classList.contains('disabled')) return;
                    
                    const action = item.dataset.menu;
                    const tid = this.state.menuTarget;
                    this.closeMenus();
                    
                    switch(action) {
                        case 'checklist':
                            this.toggleChecklist();
                            break;
                        case 'undoText':
                            if(this.state.historyIdx > 0) {
                                this.state.historyIdx--;
                                const snap = this.state.history[this.state.historyIdx];
                                
                                this.els.title.value = snap.title;
                                this.els.bodyInput.value = snap.content;
                                this.updateRenderLayer();
                                
                                const note = this.getNote(tid);
                                note.title = snap.title;
                                note.content = snap.content;
                                note.updatedAt = Date.now();
                                
                                this.saveData();
                                this.updateNoteCardInList(note);
                                this.els.lastEdited.textContent = `Last edited: ${utils.formatDate(note.updatedAt)}`;
                                this.toast('Batal Edit Berhasil');
                            }
                            break;
                        case 'pin': this.toggleProperty(tid, 'pinned', 'Note Pinned', 'Note Unpinned'); break;
                        case 'copy': this.copyNoteText(tid); break;
                        case 'rename': 
                            this.setActive(tid); 
                            setTimeout(() => { this.els.title.focus(); this.els.title.select(); }, 50); 
                            break;
                        case 'download': this.downloadTXT(tid); break;
                        case 'delete': 
                            if(this.state.filter === 'trash') { if(confirm("Delete forever?")) this.deleteNoteHard(tid); }
                            else this.deleteNoteSoft(tid);
                            break;
                    }
                });

                this.els.sortMenu.addEventListener('click', (e) => {
                    const item = e.target.closest('.menu-item');
                    if(!item) return;
                    this.data.settings.sort = item.dataset.sort;
                    this.saveData(); this.renderList(); this.closeMenus();
                });

                this.els.importFile.addEventListener('change', (e) => this.importBackup(e));
            },

            openMenu(e, targetId, menuId) {
                e.stopPropagation();
                
                if (menuId === 'globalMenu' && targetId === this.state.activeId) {
                    this.flushSave(); 
                }

                this.closeMenus();
                if(targetId) this.state.menuTarget = targetId;
                
                const menu = this.els[menuId];
                menu.style.display = 'block'; 
                const rect = e.target.getBoundingClientRect();
                
                if (menuId === 'globalMenu') {
                    const note = this.getNote(targetId);
                    const isTrash = note && note.deletedAt;
                    
                    document.getElementById('lblPin').textContent = note && note.pinned ? 'Unpin Note' : 'Pin Note';
                    document.getElementById('lblDel').textContent = isTrash ? 'Delete Forever' : 'Move to Trash';

                    if (targetId === this.state.activeId && this.state.historyIdx > 0) {
                        this.els.menuUndo.classList.remove('disabled');
                    } else {
                        this.els.menuUndo.classList.add('disabled');
                    }

                    const displayActive = isTrash ? 'none' : 'flex';
                    this.els.menuChecklist.style.display = displayActive;
                    this.els.menuUndo.style.display = displayActive;
                    this.els.menuPin.style.display = displayActive;
                    this.els.menuCopy.style.display = displayActive;
                    this.els.menuRename.style.display = displayActive;
                }
                
                let top = rect.bottom + 8;
                let left = rect.right - menu.offsetWidth; 
                
                if (left < 10) left = 10;
                if (top + menu.offsetHeight > window.innerHeight) top = rect.top - menu.offsetHeight - 8;
                
                menu.style.top = `${top}px`;
                menu.style.left = `${left}px`;
                menu.style.display = ''; 
                
                setTimeout(() => menu.classList.add('show'), 10);
            },

            closeMenus() {
                this.els.globalMenu.classList.remove('show');
                this.els.sortMenu.classList.remove('show');
                this.state.menuTarget = null;
            },

            toast(msg, showUndo = false) {
                this.els.toastMsg.textContent = msg;
                this.els.toastUndo.style.display = showUndo ? 'block' : 'none';
                
                this.els.toast.classList.add('show');
                clearTimeout(this.cache.toastTimer);
                this.cache.toastTimer = setTimeout(() => this.els.toast.classList.remove('show'), 4000);
            },

            exportBackup() {
                const exportData = {
                    version: this.data.version,
                    createdAt: this.data.createdAt,
                    notes: this.data.notes,
                    trash: this.data.trash,
                    settings: this.data.settings
                };
                const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a'); a.href = url;
                a.download = `MyNotes_Backup_${new Date().toISOString().split('T')[0]}.json`;
                a.click(); URL.revokeObjectURL(url);
                this.toast('Backup Exported Successfully');
            },

            importBackup(e) {
                const file = e.target.files[0];
                if (!file) return;
                
                const reader = new FileReader();
                reader.onload = (event) => {
                    try {
                        const p = JSON.parse(event.target.result);
                        if (p && typeof p === 'object' && Array.isArray(p.notes) && Array.isArray(p.trash) && typeof p.settings === 'object') {
                            this.data = { version: p.version || 1, createdAt: p.createdAt || Date.now(), notes: p.notes, trash: p.trash, settings: p.settings };
                            if(this.saveData()) {
                                this.state.activeId = null; this.setFilter('all'); this.toast('Backup Restored Successfully');
                            }
                        } else throw new Error('Invalid Schema');
                    } catch (err) { this.toast('Invalid Backup File'); }
                };
                reader.readAsText(file);
                e.target.value = null; 
            },

            downloadTXT(id) {
                const note = this.getNote(id);
                if (!note) return;
                const blob = new Blob([`${note.title || 'Untitled'}\n\n${note.content || ''}`], { type: 'text/plain' });
                const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
                
                const safeTitle = note.title.trim() ? note.title.trim().replace(/[^a-z0-9]/gi, '_') : 'Untitled';
                a.download = `${safeTitle.toLowerCase()}.txt`;
                a.click();
            },

            updateStorageUI() {
                const dataStr = localStorage.getItem('mynotes_final') || '';
                const bytes = utils.getSize(dataStr);
                this.els.storageProg.style.width = `${Math.min((bytes / this.cache.maxStorage) * 100, 100)}%`;
                this.els.storageLbl.textContent = `${(bytes / 1024).toFixed(1)} KB / 5 MB`;
            },

            updateTrashBadge() {
                const count = this.data.trash.length;
                this.els.trashBadge.textContent = count;
                this.els.trashBadge.style.display = count > 0 ? 'inline-block' : 'none';
            }
        };

        document.addEventListener('DOMContentLoaded', () => app.init());
    </script>
</body>
</html>
